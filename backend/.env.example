# Server
PORT=4000
NODE_ENV=development

# Database (ganti sesuai lokal / Neon)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pessay
DATABASE_POOL_MAX=20

# Auth
JWT_SECRET=ganti-ini-di-produksi-min-32-karakter
JWT_EXPIRES_IN=8h

# Redis (opsional — kosongkan untuk menonaktifkan cache)
REDIS_URL=

# CORS (asal frontend; '*' untuk dev)
CORS_ORIGIN=*

# AI grading
# Mode 'mock' = tanpa API key (demo/tes). 'real' = pakai Gemini Flash.
GRADING_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Batch worker
GRADING_BATCH_SIZE=10
GRADING_INTERVAL_MS=10000
GRADING_MAX_CONCURRENCY=3

# Ujian serentak: batas submit per 10 detik per user
RATE_LIMIT_SUBMIT_PER_10S=1